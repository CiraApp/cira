{
  "name": "cira",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build --pretty && tsc -p apps/web --noEmit --pretty && tsc -p tsconfig.test.json --pretty",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "dev": "concurrently -n types,web -c blue,magenta \"tsc --build --watch --preserveWatchOutput\" \"pnpm --filter @cira/web dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.20.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
