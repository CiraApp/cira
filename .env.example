# ---- Database -------------------------------------------------------------
# Neon Postgres. Adding the Neon integration from the Vercel dashboard injects
# this automatically on Vercel; copy it here for local development.
DATABASE_URL=

# ---- Authentication -------------------------------------------------------
# Clerk answers "who is this person" and nothing else. Keys are per environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Deployment provider --------------------------------------------------
# Cira does not own compute. These are the credentials it uses to deploy
# employees' apps on your behalf. Never exposed to a browser.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
