# ---- Database -------------------------------------------------------------
# Neon Postgres. DATABASE_URL is the POOLED connection, used by the app.
#
# Quote the values. A Neon URL ends in `?sslmode=require&channel_binding=require`,
# and `source .env.local` on an unquoted line makes bash read that `&` as a
# background operator: it splits the line, runs the front half as a job, and
# job control prints the whole thing - password included - to the terminal.
# Two passwords have had to be rotated because of exactly this. Next.js reads
# the file with a dotenv parser, which strips the quotes, so nothing else
# changes.
DATABASE_URL=

# The DIRECT connection, used only by migrations. Neon's pooler runs PgBouncer
# in transaction mode, which is the wrong shape for DDL.
DATABASE_URL_UNPOOLED=

# ---- Authentication -------------------------------------------------------
# Clerk answers "who is this person" and nothing else. Keys are per environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Deployment provider --------------------------------------------------
# Cira does not own compute. These are the credentials it uses to deploy
# employees' apps on your behalf. Never exposed to a browser.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# ---- Capability analysis ---------------------------------------------------
# Cira reads a deployed app's code and works out what it can do. One model call
# per deploy; without this, apps still deploy and simply register nothing.
ANTHROPIC_API_KEY=
